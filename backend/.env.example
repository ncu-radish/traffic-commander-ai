# 複製此檔為 .env 後填入實際值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿將真實憑證寫入本檔案。

# LLM 設定 (可填 ollama 或 aws)
LLM_PROVIDER=ollama

# Ollama 設定 (LLM_PROVIDER=ollama 時生效)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# AWS 設定 (LLM_PROVIDER=aws 時生效)
# 建議改用 AWS CLI profile 或 IAM role，避免在檔案中存放長期金鑰
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# 其他環境變數
ENVIRONMENT=development
DEBUG=true
